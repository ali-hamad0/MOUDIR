ENVIRONMENT=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://modir:modir@db:5432/modir
REDIS_URL=redis://redis:6379/0

VAULT_ADDR=http://vault:8200
VAULT_TOKEN=root

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=modir-access
MINIO_SECRET_KEY=modir-secret-changeme

# Dashboard CORS origins (Phase 3). JSON array; defaults to the Vite dev server
# if unset. Never use "*" together with credentials.
# CORS_ALLOW_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Loki log aggregator (Phase 8). Empty = disabled. Set when running with
# --profile observability so the API ships structured logs to Grafana Loki.
# LOKI_URL=http://loki:3100

# WhatsApp Business API (Phase 10).
# "dev" = log outbound messages only, never call the real Meta API (default for local/CI).
# "live" = POST to graph.facebook.com (requires a real Meta app + webhook approval).
# WHATSAPP_MODE=dev
#
# Meta's internal phone number ID (non-secret identifier, not a secret token).
# Sandbox test value (Meta test number +15556544382):
WHATSAPP_PHONE_NUMBER_ID=1237405232778967
#
# Secrets go in Vault (modir/whatsapp): WHATSAPP_API_TOKEN and WHATSAPP_VERIFY_TOKEN.
# In docker-compose, override the Vault placeholders via .vault_secrets.env:
#   WHATSAPP_API_TOKEN=EAABs...
#   WHATSAPP_VERIFY_TOKEN=my-random-string
