ENVIRONMENT=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://modir:modir@db:5432/modir
REDIS_URL=redis://redis:6379/0

VAULT_ADDR=http://vault:8200
VAULT_TOKEN=root

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=modir-access
MINIO_SECRET_KEY=modir-secret-changeme

# Dashboard CORS origins (Phase 3). JSON array; defaults to the Vite dev server
# if unset. Never use "*" together with credentials.
# CORS_ALLOW_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Loki log aggregator (Phase 8). Empty = disabled. Set when running with
# --profile observability so the API ships structured logs to Grafana Loki.
# LOKI_URL=http://loki:3100

# WhatsApp Business API (Phase 10).
# "dev" = log outbound messages only, never call the real Meta API (default for local/CI).
# "live" = POST to graph.facebook.com (requires a real Meta app + webhook approval).
# WHATSAPP_MODE=dev
#
# Meta's internal phone number ID (non-secret identifier, not a secret token).
# Sandbox test value (Meta test number +15556544382):
WHATSAPP_PHONE_NUMBER_ID=1237405232778967
#
# Secrets go in Vault (modir/whatsapp): WHATSAPP_API_TOKEN and WHATSAPP_VERIFY_TOKEN.
# In docker-compose, override the Vault placeholders via .vault_secrets.env:
#   WHATSAPP_API_TOKEN=EAABs...
#   WHATSAPP_VERIFY_TOKEN=my-random-string

# Billing (Phase 11, manual subscriptions). Both optional and non-secret.
# A static Whish Money pay link (or QR URL) shown to owners whose subscription
# lapsed; empty hides the button. No gateway API in v1 — payments are recorded
# manually by the founder in the admin dashboard.
# BILLING_WHISH_LINK=https://whish.money/pay/...
# The founder's WhatsApp number for renewals/upgrades (owners get a wa.me link).
# BILLING_CONTACT_PHONE=+96170000000

# Whish Pay collect API (Phase 11) — online Pro checkout ($20/mo).
# "off" (default) = in-app checkout disabled; the subscribe button links to BILLING_WHISH_LINK
# and the founder activates manually after the owner sends the receipt on WhatsApp.
# "dev" = simulate the whole checkout locally, never call the network (CI/tests only).
# "live" = real Whish API; requires merchant onboarding at https://apps.whish.money
# WHISH_PAY_MODE=off
# WHISH_PAY_BASE_URL=https://lb.sandbox.whish.money/itel-service/api
# Where Whish redirects the payer after the hosted page (the dashboard route):
# BILLING_RESULT_BASE_URL=http://localhost:5173/billing/result
# Secrets go in Vault (modir/whish): WHISH_PAY_CHANNEL and WHISH_PAY_SECRET
# (issued by Whish after merchant verification).
