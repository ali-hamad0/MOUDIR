__pycache__/
*.pyc
.venv/
.env
.env.local
.vault_secrets.env
secrets/
# Secrets / cloud credentials — NEVER commit. The real GCP service-account key is
# provided to the app via Vault (modir/ocr), never the repo. These patterns catch
# the common credential filenames without hiding legitimate config JSON.
*-service-account*.json
*service_account*.json
*-credentials*.json
gcp-*.json
moudir-*.json
*.pem
*.key
*.db
*.log
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
node_modules/
dist/
build/
.DS_Store
docs/PHASE_*
docs/DECISIONS.md
# Dev-only compose overrides (bind-mounts, exposed ports)
docker-compose.override.yml
# Claude Code harness artifacts
.claude/scheduled_tasks.lock
# Locally-installed Claude Code skills (install per-machine, not tracked)
.claude/skills/
# Personal IDE settings
.vscode/
# Phase 6 ML training-data snapshots (data, not code — exported for offline/Colab use)
ml_export/
backend/ml_export/
# Phase 12 ASR — the fine-tuned Whisper artifact (~1 GB) is NOT committed (AD-12.4);
# it is fetched out-of-repo (Release/HF/MinIO). artifacts/ holds ONLY the ignored
# weights/processor; the dir is kept via its .gitkeep. The small model_card.json IS
# committed (AD-12.4) but lives OUTSIDE artifacts/ — git cannot re-include a file whose
# parent dir is excluded, so the card's committed home (Task 12.3) is app/asr/, not here.
backend/app/asr/artifacts/*
!backend/app/asr/artifacts/.gitkeep
# Phase 8 backup archives — not versioned; .gitkeep files mark the directories
backups/postgres/*.sql.gz
backups/minio/*/

# Ad-hoc webhook test payloads (manual curl testing) — never commit
/test_*.json
